# --- secrets: never commit ------------------------------------------------------
.env
.env.*
!.env.example

# --- household data: raw power never leaves the house (spec 11) -----------------
csv/
data/
# runtime state: ledger, console snapshot, event logs, cached insights, model replies
var/

# --- written by the labelling pass ----------------------------------------------
labels/*.bak

# --- temp files: atomic writes rename a *.tmp over the target; a crash can leave one
*.tmp

# --- Python ---------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# --- OS / editors / sync --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.dropbox
.dropbox.attr

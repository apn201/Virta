# Virta config - copy to .env and fill in. .env is git-ignored.
# Real environment variables always take precedence over this file.

# --- Nebius Token Factory (cloud reasoning, spec 2/6) -----------------------
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT_S=60
NEBIUS_MAX_TOKENS=2048

# --- Home Assistant (local LAN, read-only, spec 11) -------------------------
HA_BASE_URL=http://192.168.86.33:8123
HA_TOKEN=
HA_POLL_INTERVAL_S=15

# Entity ids default to the spec 11 config block; override only if HA renames one.
#SENSOR_PHASE_A=sensor.3em_channel_a_power
#SENSOR_PHASE_B=sensor.3em_channel_b_power
#SENSOR_PHASE_C=sensor.3em_channel_c_power
#SENSOR_TOTAL=sensor.3em_total_power
#SENSOR_NORDPOOL=sensor.nordpool_kwh_fi_eur_3_10_0255
#SENSOR_TEMP_OUT=sensor.current_temperature
#SENSOR_TEMP_IN=sensor.temperature_average
#SENSOR_SUN=sun.sun

# --- Cloud cost control (spec 8) --------------------------------------------
# Price tiers in c/kWh. HA uses a moving average-based threshold; these are the
# fixed-mode starting point. Negative prices are their own tier automatically.
PRICE_CHEAP_MAX_C=5
PRICE_NORMAL_MAX_C=8
PRICE_EXPENSIVE_MAX_C=12

CLOUD_DEBOUNCE_S=8
MAX_CLOUD_CALLS_PER_HOUR=30
MAX_CLOUD_CALLS_PER_DAY=250
CLOUD_HEARTBEAT_MINUTES=30

# Kill switch: set to 0, or create the file below, to stop all cloud calls.
VIRTA_CLOUD_ENABLED=1
CLOUD_KILL_SWITCH_PATH=var/CLOUD_OFF
CLOUD_USAGE_STATE_PATH=var/cloud_usage.json

# Spend tracking - leave at 0 until the model's real token prices are known.
#COST_PER_1M_INPUT_TOKENS=0
#COST_PER_1M_OUTPUT_TOKENS=0
#DAILY_SPEND_CEILING=0
